# LOCAL DEVELOPMENT ONLY. Never reuse these values in a public deployment.
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=local-development-only-change-me
FRONTEND_ORIGIN=http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_PORT=8000

# Retained for local database-backed development modules; not required by the public demo API.
POSTGRES_DB=compatflow
POSTGRES_USER=compatflow_local
POSTGRES_PASSWORD=local-only-change-this-password
DATABASE_URL=postgresql+psycopg://compatflow_local:local-only-change-this-password@db:5432/compatflow

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

IMPORT_STORAGE_DIR=/data/imports
IMPORT_MAX_UPLOAD_BYTES=5242880

# This is embedded into the frontend at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Set these to real details before public launch.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# Public website origin; use HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
